{
  "name": "familia-fit",
  "productName": "Familia Fit",
  "version": "2026.11.28",
  "description": "Alimentação e movimento de toda a família — versão para computador",
  "main": "main.js",
  "author": {
    "name": "Família Fit",
    "email": "familia-fit@users.noreply.github.com"
  },
  "homepage": "https://github.com/HVS87/Familia-Fit",
  "license": "SEE LICENSE IN ../LICENSE",
  "private": true,
  "scripts": {
    "preparar": "node scripts/preparar.js",
    "start": "npm run preparar && electron .",
    "dist": "npm run preparar && electron-builder --publish never",
    "dist:win": "npm run preparar && electron-builder --win --publish never",
    "dist:mac": "npm run preparar && electron-builder --mac --publish never",
    "dist:linux": "npm run preparar && electron-builder --linux --publish never"
  },
  "build": {
    "appId": "pt.familiafit.app",
    "productName": "Familia Fit",
    "copyright": "Família Fit",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "autoteste.js",
      "app/**/*",
      "package.json",
      "!scripts/**"
    ],
    "artifactName": "familia-fit-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Família Fit",
      "installerLanguages": [
        "pt_PT"
      ],
      "language": "2070",
      "artifactName": "familia-fit-${version}-instalador-windows.${ext}"
    },
    "portable": {
      "artifactName": "familia-fit-${version}-portatil-windows.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.healthcare-fitness",
      "icon": "build/icon.png",
      "artifactName": "familia-fit-${version}-mac-${arch}.${ext}",
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "CFBundleDisplayName": "Família Fit"
      }
    },
    "dmg": {
      "title": "Familia Fit${arch}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "maintainer": "Família Fit <familia-fit@users.noreply.github.com>",
      "synopsis": "Alimentação e movimento de toda a família",
      "artifactName": "familia-fit-${version}-linux-${arch}.${ext}"
    },
    "afterPack": "scripts/assinar-mac.js"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "allowScripts": {
    "electron@33.2.1": true
  }
}
